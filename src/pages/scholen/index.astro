---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBox from '../../components/SearchBox.astro';

const cities = (await getCollection('cities')).sort((a, b) =>
  a.data.city.localeCompare(b.data.city, 'nl')
);
const gyms = await getCollection('gyms');

const counts = new Map<string, number>();
for (const g of gyms) {
  const cs = g.data.citySlug;
  if (cs) counts.set(cs, (counts.get(cs) || 0) + 1);
}

const groups = new Map<string, typeof cities>();
for (const c of cities) {
  const letter = (c.data.city[0] || '#').toUpperCase();
  const key = /[A-Z]/.test(letter) ? letter : '#';
  if (!groups.has(key)) groups.set(key, [] as any);
  groups.get(key)!.push(c);
}
const letters = [...groups.keys()].sort();
const nf = (n: number) => n.toLocaleString('nl-NL');
---

<BaseLayout
  title="Alle boksscholen in Nederland vind je hier (Boxing gyms)!"
  description="Bekijk hier een lijst van boksscholen bij jou in de buurt. Vind direct een boxing gym in jouw regio en begin met trainen!"
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Register</div>
      <h1>Boksscholen in Nederland</h1>
      <p class="sub">
        Op zoek naar een boksschool bij jou in de buurt? Hieronder vind je alle
        regio&rsquo;s waar je in Nederland kunt boksen &mdash;
        {nf(gyms.length)} sportscholen in {nf(cities.length)} plaatsen.
      </p>
      <SearchBox id="scholen-search" placeholder="Zoek op plaats of schoolnaam…" />
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <span>Boksscholen in Nederland</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      <nav class="alpha-nav" aria-label="Spring naar letter">
        {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </nav>

      {letters.map((l) => (
        <div class="letter-group" id={`letter-${l}`}>
          <h3>{l}</h3>
          <ul class="col-list">
            {groups.get(l)!.map((c) => (
              <li>
                <a href={`/scholen/${c.id}/`}>{c.data.city}</a>
                {counts.get(c.id) ? <span class="count-pill"> ({counts.get(c.id)})</span> : null}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
