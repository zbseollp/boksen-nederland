---
import { footerData } from '../data/footer';

const year = new Date().getFullYear();

// één keer per build berekend, niet per pagina
const { gymCount, cityCount, topCities } = await footerData;

const sections = [
  { href: '/scholen/', label: 'Alle boksscholen' },
  { href: '/boksers/', label: 'Boksers' },
  { href: '/boksen/', label: 'Boksen' },
  { href: '/nieuws/', label: 'Nieuws' },
];

const about = [
  { href: '/over-ons/', label: 'Over ons' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacyverklaring/', label: 'Privacyverklaring' },
  { href: '/algemene-voorwaarden/', label: 'Algemene voorwaarden' },
  { href: '/sitemap/', label: 'Sitemap' },
];

const nf = (n: number) => n.toLocaleString('nl-NL');
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <img src="/logo.svg" alt="Boksen-Nederland.nl" height="30" />
        </div>
        <p>
          Het overzicht van boksscholen en sportscholen in Nederland waar je kunt
          boksen. {nf(gymCount)} sportscholen in {nf(cityCount)} plaatsen &mdash;
          vind een school bij jou in de buurt, bekijk trainingstijden en neem contact
          op voor een proefles.
        </p>
      </div>

      <div>
        <h4>Grote steden</h4>
        <ul>
          {topCities.map((c) => (
            <li><a href={`/scholen/${c.slug}/`}>{c.city}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Op de site</h4>
        <ul>
          {sections.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Juridisch</h4>
        <ul>
          {about.map((a) => (
            <li><a href={a.href}>{a.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} Boksen-Nederland.nl &mdash; Alle rechten voorbehouden.</span>
      <span>Boksscholen en sportscholen in heel Nederland.</span>
    </div>
  </div>
</footer>
