---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout
  title="Nieuws - Boksen-Nederland.nl"
  description="Bekijk hier het laatste boksen nieuws van Nederland: achtergronden, tips en verhalen uit de bokssport."
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Bokssport</div>
      <h1>Nieuws</h1>
      <p class="sub">Bekijk hieronder het laatste boksen nieuws van Nederland.</p>
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <span>Nieuws</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Alle artikelen</h2>
          <p>{posts.length} artikelen, nieuwste eerst.</p>
        </div>
      </div>

      <div class="grid grid-3">
        {posts.map((post) => (
          <article class="card">
            {post.data.heroImage && (
              <div class="card-media">
                <img src={post.data.heroImage} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              {post.data.categories?.[0] && <span class="tag">{post.data.categories[0]}</span>}
              <h3 style="margin-top:.6rem"><a href={`/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
