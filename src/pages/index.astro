---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, 3);

const cities = await getCollection('cities');
const gyms = await getCollection('gyms');

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

// tel vermeldingen per stad om de grootste regio's bovenaan te zetten
const counts = new Map<string, number>();
for (const g of gyms) {
  const cs = g.data.citySlug;
  if (cs) counts.set(cs, (counts.get(cs) || 0) + 1);
}
const topCities = [...cities]
  .sort((a, b) => (counts.get(b.id) || 0) - (counts.get(a.id) || 0))
  .slice(0, 12);
---

<BaseLayout
  title="Boksen Nederland - Boksen Community Nederland"
  description="Boksen-Nederland.nl is de boksen community van Nederland. Vindt hier Informatie over de sport boksen!"
>
  <section class="hero">
    <div class="wrap lead">
      <h1>Welkom op Boksen-Nederland.nl</h1>
      <p>
        De grootste bokscommunity van Nederland. Via onze website kun je alles te
        weten komen over de sport boksen! Helemaal nieuw in de sport? Lees je direct
        verder in! Benieuwd waar je allemaal kunt boksen in Nederland? Kom erachter
        via onze site!
      </p>
      <div class="hero-actions">
        <a class="btn" href="/scholen/">Vind een boksschool</a>
        <a class="btn btn-ghost" href="/boksen/">Bokssport uitgelegd</a>
      </div>

      <div class="stat-row">
        <div class="stat">
          <strong>{gyms.length.toLocaleString('nl-NL')}</strong>
          <span>sportscholen</span>
        </div>
        <div class="stat">
          <strong>{cities.length.toLocaleString('nl-NL')}</strong>
          <span>plaatsen</span>
        </div>
        <div class="stat">
          <strong>{posts.length}</strong>
          <span>nieuwsartikelen</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Boksschool bij jou in de buurt</h2>
        <p>
          Op zoek naar een boksschool bij jou in de buurt? Hieronder kun je direct
          bekijken welke locaties er allemaal in jouw omgeving zijn!
        </p>
      </div>

      <div class="grid grid-4">
        {topCities.map((c) => (
          <a class="tile" href={`/scholen/${c.id}/`}>
            <strong>{c.data.city}</strong>
            <span>{counts.get(c.id) || 0} sportscholen</span>
          </a>
        ))}
      </div>

      <div style="text-align:center;margin-top:2.5rem">
        <a class="btn" href="/scholen/">Alle plaatsen bekijken</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Laatste sportnieuws</h2>
        <p>Bekijk hieronder het laatste boksen nieuws van Nederland.</p>
      </div>

      <div class="grid grid-3">
        {recent.map((post) => (
          <article class="card">
            {post.data.heroImage && (
              <a href={`/${post.id}/`} class="card-media">
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div style="text-align:center;margin-top:2.5rem">
        <a class="btn" href="/nieuws/">Al het nieuws bekijken</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Staat jouw sportschool er niet bij?</h2>
          <p>Laat het ons weten, dan voegen we de gegevens toe.</p>
        </div>
        <a class="btn" href="/contact/">Neem contact op</a>
      </div>
    </div>
  </section>
</BaseLayout>
