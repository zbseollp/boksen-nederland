---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  const gyms = await getCollection('gyms');

  const byCity = new Map<string, typeof gyms>();
  for (const g of gyms) {
    const cs = g.data.citySlug;
    if (!cs) continue;
    if (!byCity.has(cs)) byCity.set(cs, [] as any);
    byCity.get(cs)!.push(g);
  }

  return cities.map((entry) => ({
    params: { city: entry.id },
    props: {
      entry,
      gyms: (byCity.get(entry.id) || []).sort((a, b) =>
        a.data.title.localeCompare(b.data.title, 'nl')
      ),
    },
  }));
}

const { entry, gyms } = Astro.props;
const d = entry.data;

const known = new Set(gyms.map((g: any) => `/${g.id}/`));
const extra = (d.gyms || []).filter((g: any) => !known.has(g.href));
const total = gyms.length + extra.length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Boksscholen in ${d.city}`,
  url: new URL(Astro.url.pathname, Astro.site).href,
  numberOfItems: total,
};
---

<BaseLayout
  title={d.metaTitle || `Boksen in ${d.city} — Boksen-Nederland.nl`}
  description={d.metaDesc || `Alle boksscholen en sportscholen in ${d.city} waar je kunt boksen.`}
  schema={schema}
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Boksscholen</div>
      <h1>Boksen in {d.city}</h1>
      <p class="sub">
        {d.intro ||
          `Op zoek naar een boksschool in ${d.city}? Hieronder vind je alle sportscholen in ${d.city} waar je kunt boksen, met adres, contactgegevens en trainingstijden.`}
      </p>
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/scholen/">Boksscholen</a>
      <span class="sep">›</span>
      <span>{d.city}</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      {total > 0 && (
        <div class="filter-bar" data-city-filter>
          <label class="filter-input">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
            </svg>
            <input type="search" placeholder={`Filter binnen ${d.city}…`} aria-label={`Filter sportscholen in ${d.city}`} />
          </label>
          <span class="filter-count" data-count>
            {total} {total === 1 ? 'sportschool' : 'sportscholen'}
          </span>
        </div>
      )}

      {gyms.length > 0 && (
        <div class="grid grid-3" data-filter-list>
          {gyms.map((g: any) => (
            <a class="tile" href={`/${g.id}/`} data-name={g.data.title.toLowerCase()}>
              <strong>{g.data.title}</strong>
              <span>{g.data.address || d.city}</span>
            </a>
          ))}
        </div>
      )}

      {extra.length > 0 && (
        <>
          <h2 style="margin-top:2.5rem;font-size:1.25rem">Overige sportscholen</h2>
          <ul class="chip-list" data-filter-list>
            {extra.map((g: any) => (
              <li data-name={g.name.toLowerCase()}><a href={g.href}>{g.name}</a></li>
            ))}
          </ul>
        </>
      )}

      <p class="empty-state" data-empty hidden>
        Geen sportscholen gevonden die aan je filter voldoen.
      </p>

      {total === 0 && (
        <p class="empty-state">Er zijn nog geen sportscholen bekend in {d.city}.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Sportschool toevoegen?</h2>
          <p>Mis je een boksschool in {d.city}? Laat het ons weten.</p>
        </div>
        <a class="btn" href="/contact/">Neem contact op</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-city-filter]');
  if (bar) {
    const input = bar.querySelector<HTMLInputElement>('input');
    const countEl = bar.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const items = [
      ...document.querySelectorAll<HTMLElement>('[data-filter-list] [data-name]'),
    ];
    const total = items.length;

    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const el of items) {
        const hit = !q || (el.dataset.name || '').includes(q);
        el.style.display = hit ? '' : 'none';
        if (hit) shown++;
      }
      if (countEl) {
        countEl.textContent = q
          ? `${shown} van ${total} ${total === 1 ? 'sportschool' : 'sportscholen'}`
          : `${total} ${total === 1 ? 'sportschool' : 'sportscholen'}`;
      }
      if (empty) empty.hidden = shown !== 0;
    });
  }
</script>
