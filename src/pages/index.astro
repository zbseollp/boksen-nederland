---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recent = posts.slice(0, 3);

const cities = await getCollection('cities');
const gyms = await getCollection('gyms');
const boxers = await getCollection('boxers');

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const counts = new Map<string, number>();
for (const g of gyms) {
  const cs = g.data.citySlug;
  if (cs) counts.set(cs, (counts.get(cs) || 0) + 1);
}
const topCities = [...cities]
  .sort((a, b) => (counts.get(b.id) || 0) - (counts.get(a.id) || 0))
  .slice(0, 12);

const featuredBoxers = [...boxers]
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'nl'))
  .slice(0, 6);

const nf = (n: number) => n.toLocaleString('nl-NL');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Boksen-Nederland.nl',
  url: 'https://boksen-nederland.nl/',
  description:
    'De boksen community van Nederland: vind boksscholen, bekijk boksrecords en lees het laatste boksnieuws.',
};
---

<BaseLayout
  title="Boksen Nederland - Boksen Community Nederland"
  description="Boksen-Nederland.nl is de boksen community van Nederland. Vindt hier Informatie over de sport boksen!"
  schema={schema}
>
  <section class="hero">
    <div class="wrap lead">
      <h1>Vind jouw boksschool</h1>
      <p class="sub">
        Welkom op Boksen-Nederland.nl, de grootste bokscommunity van Nederland. Zoek
        tussen {nf(gyms.length)} sportscholen in {nf(cities.length)} plaatsen, bekijk
        boksrecords en lees het laatste nieuws uit de bokssport.
      </p>

      <SearchBox />

      <div class="stat-row">
        <div class="stat">
          <strong>{nf(gyms.length)}</strong>
          <span>sportscholen</span>
        </div>
        <div class="stat">
          <strong>{nf(cities.length)}</strong>
          <span>plaatsen</span>
        </div>
        <div class="stat">
          <strong>{boxers.length}</strong>
          <span>boksers</span>
        </div>
        <div class="stat">
          <strong>{posts.length}</strong>
          <span>artikelen</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Boksen in de grote steden</h2>
          <p>
            Op zoek naar een boksschool bij jou in de buurt? Begin hier &mdash; of
            gebruik de zoekbalk voor je eigen plaats.
          </p>
        </div>
        <a class="btn btn-quiet btn-sm" href="/scholen/">Alle {nf(cities.length)} plaatsen</a>
      </div>

      <div class="grid grid-4">
        {topCities.map((c) => (
          <a class="tile" href={`/scholen/${c.id}/`}>
            <strong>{c.data.city}</strong>
            <span>{counts.get(c.id) || 0} sportscholen</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="section-head wrap">
      <div>
        <h2>Laatste sportnieuws</h2>
        <p>Achtergronden, tips en verhalen uit de bokssport.</p>
      </div>
      <a class="btn btn-quiet btn-sm" href="/nieuws/">Al het nieuws</a>
    </div>
    <div class="wrap">
      <div class="grid grid-3">
        {recent.map((post) => (
          <article class="card">
            {post.data.heroImage && (
              <div class="card-media">
                <img src={post.data.heroImage} alt="" loading="lazy" />
              </div>
            )}
            <div class="card-body">
              {post.data.categories?.[0] && <span class="tag">{post.data.categories[0]}</span>}
              <h3 style="margin-top:.55rem"><a href={`/${post.id}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{dateFmt(post.data.pubDate)}</time>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Boksrecords</h2>
          <p>Bekijk de statistieken, titels en gevechten van bekende boksers.</p>
        </div>
        <a class="btn btn-quiet btn-sm" href="/boksers/">Alle boksers</a>
      </div>

      <ul class="chip-list">
        {featuredBoxers.map((b) => (
          <li><a href={`/${b.id}/`}>{b.data.title.replace(' boxing record', '')}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>Staat jouw sportschool er niet bij?</h2>
          <p>Laat het ons weten, dan voegen we de gegevens toe.</p>
        </div>
        <a class="btn" href="/contact/">Sportschool aanmelden</a>
      </div>
    </div>
  </section>
</BaseLayout>
