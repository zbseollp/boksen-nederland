---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { PAGE_SIZE } from '../../lib/pagination';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
---

<BaseLayout
  title="Nieuws - Boksen-Nederland.nl"
  description="Bekijk hier het laatste boksen nieuws van Nederland: achtergronden, tips en verhalen uit de bokssport."
>
  <section class="hero hero-compact">
    <div class="wrap lead">
      <div class="eyebrow-line">Bokssport</div>
      <h1>Nieuws</h1>
      <p class="sub">Bekijk hieronder het laatste boksen nieuws van Nederland.</p>
    </div>
  </section>

  <div class="wrap">
    <nav class="crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <span>Nieuws</span>
    </nav>
  </div>

  <section class="section">
    <div class="wrap">
      <PostList
        posts={posts}
        allPosts={allPosts}
        page={1}
        totalPages={totalPages}
        total={allPosts.length}
        basePath="/nieuws"
      />
    </div>
  </section>
</BaseLayout>
